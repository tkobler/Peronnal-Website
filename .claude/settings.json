{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-main-commit.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(xargs ls:*)",
      "Bash(grep -v \"^\\\\.$\\\\|^\\\\.\\\\.$\")",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npx next:*)",
      "Bash(npx playwright:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsx:*)",
      "Bash(find . -name '*Edit conflict*' -not -path './.git/*' -not -path './.next/*' -type f -delete)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000/)",
      "Bash(curl -s -o /dev/null http://localhost:3000/projects)",
      "Bash(curl -s -o /dev/null http://localhost:3000/experience)",
      "Bash(curl -s -o /dev/null http://localhost:3000/hobby)",
      "Bash(curl -s -o /dev/null http://localhost:3000/contact)",
      "Bash(curl -s -o /dev/null http://localhost:3000/about)",
      "Bash(lsof -i :3000 -sTCP:LISTEN)",
      "Bash(curl -s -o /dev/null http://localhost:3000/)",
      "Bash(open http://localhost:3000)",
      "Bash(gh api:*)",
      "Bash(brew install:*)",
      "Bash(gh auth:*)",
      "WebFetch(domain:github.com)",
      "Bash(typst --version)",
      "Bash(chmod +x cv/build.sh)",
      "Bash(./cv/build.sh)",
      "Bash(typst compile:*)",
      "Bash(typst fonts:*)",
      "Bash(ls -lh cv/output/*.pdf)",
      "Bash(node -e \":*)",
      "Bash(curl -s http://localhost:3000/)",
      "Bash(python3 -c \":*)",
      "WebFetch(domain:edu.epfl.ch)"
    ]
  }
}
